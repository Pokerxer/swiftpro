# Resend API Key (for contact form emails)
# Get your API key from https://resend.com
RESEND_API_KEY=

# Contact form submission email
CONTACT_EMAIL=info@swiftpro.com.ng

# WhatsApp number (without + symbol)
WHATSAPP_NUMBER=23480079438776

# Site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Strapi CMS
NEXT_PUBLIC_STRAPI_URL=https://swiftpro-server-production.up.railway.app

# Google Analytics
# Get your Measurement ID from https://analytics.google.com
NEXT_PUBLIC_GA_ID=

# Sanity CMS
# Get your project ID from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01